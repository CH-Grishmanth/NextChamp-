# Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://nextchamp:password@localhost:5432/nextchamp_dev
POSTGRES_USER=nextchamp
POSTGRES_PASSWORD=password
POSTGRES_DB=nextchamp_dev

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production

# File Storage
UPLOAD_DIR=uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=nextchamp-uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# External APIs
AI_ANALYSIS_PROVIDER=mock
AI_ANALYSIS_API_KEY=your-ai-api-key

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100